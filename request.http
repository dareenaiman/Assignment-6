========================

15-
db.books.deleteMany({ year: { $lt: 2000 } })
========================
16-
db.books.aggregate([
  { $match: { year: { $gt: 2000 } } },
  { $sort: { year: -1 } }
])

db.logs.aggregate([
  {
    $lookup: {
      from: "books",
      let: { searchId: "$book_id" }, 
      pipeline: [
        { $match: { $expr: { $eq: [{ $toString: "$_id" }, "$$searchId"] } } },
        { $project: { _id: 0, title: 1, author: 1, year: 1 } }
      ],
      as: "book_details"
    }
  },
  { $project: { _id: 0, action: 1, book_details: 1 } }
])