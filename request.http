1-
db.createCollection("books", {
   validator: {
      $jsonSchema: {
         bsonType: "object",
         required: ["title"],
         properties: {
            title: {
               bsonType: "string",
               minLength: 1,
               description: "title is required and must be a non-empty string"
            }
         }
      }
   }
})

